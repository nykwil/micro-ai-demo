modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd micro-ai-demo && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33307
externalPort = 3000

[deployment]
deploymentTarget = "static"
run = ["bash", "-c", "cd micro-ai-demo && npx vite preview --host 0.0.0.0 --port 5000"]
build = ["bash", "-c", "cd micro-ai-demo && npm run build"]
publicDir = "micro-ai-demo/dist"
